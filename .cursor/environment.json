{
  "name": "Tropic Time Checker",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "web-ui",
      "command": "TROPIC_HOST=0.0.0.0 TROPIC_PORT=8080 .venv/bin/python run_web.py"
    },
    {
      "name": "license-server",
      "command": "LICENSE_HOST=0.0.0.0 LICENSE_PORT=8082 LICENSE_ADMIN_TOKEN=dev-admin-token .venv/bin/python run_license_server.py"
    }
  ],
  "ports": [8080, 8082]
}
