<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OpenBulletUpstreamRoot>$(MSBuildThisFileDirectory)upstream/openbullet</OpenBulletUpstreamRoot>
    <OpenBulletVersion>1.2.2</OpenBulletVersion>
  </PropertyGroup>
</Project>
