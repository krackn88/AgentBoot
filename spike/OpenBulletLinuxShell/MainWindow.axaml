<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenBulletLinuxShell.MainWindow"
        Title="Open Bullet"
        Width="800" Height="620"
        MinWidth="800" MinHeight="600"
        Background="#222222"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        SystemDecorations="BorderOnly">
  <Grid RowDefinitions="30,30,*">
    <!-- Custom title bar (WPF MainWindow uses WindowStyle=None + manual chrome) -->
    <Grid Grid.Row="0" Background="#111111" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="4,0">
        <Border Width="22" Height="22" Background="#1E90FF" CornerRadius="2" />
        <TextBlock Text="Open Bullet" Foreground="#DCDCDC" FontSize="14" VerticalAlignment="Center" />
      </StackPanel>
      <Panel Grid.Column="1" Background="#111111" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0">
        <TextBlock Text="—" Foreground="#DCDCDC" VerticalAlignment="Center" />
        <TextBlock Text="□" Foreground="#DCDCDC" VerticalAlignment="Center" />
        <TextBlock Text="×" Foreground="#DCDCDC" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Top menu strip -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="10,0">
      <TextBlock Text="Runner" FontWeight="Bold" Foreground="#1E90FF" />
      <TextBlock Text="Configs" FontWeight="Bold" Foreground="#DCDCDC" />
      <TextBlock Text="Wordlists" FontWeight="Bold" Foreground="#DCDCDC" />
      <TextBlock Text="Proxies" FontWeight="Bold" Foreground="#DCDCDC" />
      <TextBlock Text="Hits DB" FontWeight="Bold" Foreground="#DCDCDC" />
      <TextBlock Text="Tools" FontWeight="Bold" Foreground="#DCDCDC" />
      <TextBlock Text="Plugins" FontWeight="Bold" Foreground="#DCDCDC" />
      <TextBlock Text="Settings" FontWeight="Bold" Foreground="#DCDCDC" />
    </StackPanel>

    <Border Grid.Row="2" Margin="10" Background="#111111" CornerRadius="2" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Text="Linux UI spike" Foreground="#DCDCDC" FontSize="16" FontWeight="Bold" />
        <TextBlock Text="Avalonia 11 on .NET 8 — dark Metro-style shell matching OB 1.2.2 palette."
                   Foreground="#AAAAAA" TextWrapping="Wrap" />
        <TextBlock Text="Next: port real views from OpenBullet/Views and wire RuriLib on net8."
                   Foreground="#AAAAAA" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
