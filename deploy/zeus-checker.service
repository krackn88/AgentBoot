[Unit]
Description=Zeus Network Checker Web UI
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/zeus-checker
Environment=ZEUS_DATA_DIR=/opt/zeus-checker/data
ExecStart=/opt/zeus-checker/.venv/bin/uvicorn server.app:app --host 0.0.0.0 --port 8093
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
