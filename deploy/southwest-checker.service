[Unit]
Description=Southwest Rapid Rewards Checker UI
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/southwest-checker
Environment=PATH=/opt/southwest-checker/.venv/bin:/usr/bin:/bin
EnvironmentFile=-/opt/southwest-checker/.env
ExecStart=/opt/southwest-checker/.venv/bin/uvicorn server.app:app --host 0.0.0.0 --port 8093
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
