[Unit]
Description=Fabletics Checker UI
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/fabletics-checker
Environment=PATH=/opt/fabletics-checker/.venv/bin
EnvironmentFile=-/opt/fabletics-checker/.env
ExecStart=/opt/fabletics-checker/.venv/bin/uvicorn server.app:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
