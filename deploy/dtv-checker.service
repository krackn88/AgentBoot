[Unit]
Description=DTV Checker UI
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/dtv-checker
Environment=PATH=/opt/dtv-checker/.venv/bin
EnvironmentFile=-/opt/dtv-checker/.env
ExecStart=/opt/dtv-checker/.venv/bin/uvicorn server.app:app --host 0.0.0.0 --port 8091
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
