<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OpenBullet.Linux.Views"
             x:Class="OpenBullet.Linux.Views.ConfigsSectionView">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
      <Button x:Name="ManagerTab" Content="Manager" Click="OnManager" Background="Transparent" BorderThickness="0"
              Foreground="#1E90FF" FontWeight="Bold" />
      <Button x:Name="StackerTab" Content="Stacker" Click="OnStacker" Background="Transparent" BorderThickness="0"
              Foreground="#DCDCDC" FontWeight="Bold" />
    </StackPanel>
    <ContentControl x:Name="InnerHost" Grid.Row="1" />
  </Grid>
</UserControl>
