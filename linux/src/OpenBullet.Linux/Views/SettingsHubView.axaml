<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OpenBullet.Linux.Views"
             x:Class="OpenBullet.Linux.Views.SettingsHubView">
  <TabControl>
    <TabItem Header="RuriLib">
      <views:RuriLibSettingsView x:Name="RuriTab" />
    </TabItem>
    <TabItem Header="OpenBullet">
      <views:OpenBulletSettingsView x:Name="ObTab" />
    </TabItem>
  </TabControl>
</UserControl>
