<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:OpenBullet.Linux.Services"
             xmlns:edit="using:AvaloniaEdit"
             x:Class="OpenBullet.Linux.Views.StackerView"
             x:DataType="services:StackerHost">
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="3*,8,2*">
    <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,*,Auto">
      <TextBlock Grid.Row="0" Text="LoliScript" Foreground="{DynamicResource ObForegroundToCheck}" FontWeight="Bold"
                 HorizontalAlignment="Center" Margin="0,0,0,6" />
      <Border Grid.Row="1" Background="{DynamicResource ObBackgroundSecondary}" CornerRadius="2" Padding="2">
        <edit:TextEditor x:Name="ScriptEditor"
                         FontFamily="Consolas,Courier New,monospace"
                         FontSize="13"
                         ShowLineNumbers="True"
                         WordWrap="False"
                         Background="#181818"
                         Foreground="{DynamicResource ObForegroundMain}" />
      </Border>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Classes="ob-primary" Content="Apply script to config" Click="OnApply" />
        <TextBlock VerticalAlignment="Center" Foreground="#888" Text="{Binding ConfigTitle}" />
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ObForegroundGood}" Text="{Binding StatusMessage}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="0" Grid.Column="2" RowDefinitions="Auto,Auto,*">
      <TextBlock Text="Block stack" Foreground="{DynamicResource ObForegroundGood}" FontWeight="Bold" Margin="0,0,0,6" />
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
        <Button Content="+" Click="OnAddBlock" />
        <Button Content="−" Click="OnRemoveBlock" />
        <Button Content="↑" Click="OnMoveUp" />
        <Button Content="↓" Click="OnMoveDown" />
      </StackPanel>
      <ListBox Grid.Row="2" x:Name="BlockList" ItemsSource="{Binding Blocks}"
               SelectedItem="{Binding SelectedBlock}"
               Classes="ob-list" Background="{DynamicResource ObBackgroundSecondary}" />
    </Grid>

    <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="10"
            Background="{DynamicResource ObBackgroundSecondary}" CornerRadius="2">
      <Grid RowDefinitions="Auto,Auto,100">
        <TextBlock Text="Debugger (step-through)" Foreground="{DynamicResource ObForegroundCustom}" FontWeight="Bold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,6">
          <TextBlock VerticalAlignment="Center" Text="Data" />
          <TextBox Width="180" Text="{Binding Debugger.TestData}" />
          <TextBlock VerticalAlignment="Center" Text="Proxy" />
          <TextBox Width="140" Text="{Binding Debugger.TestProxy}" />
          <CheckBox Content="Use proxy" IsChecked="{Binding Debugger.UseProxy}" />
          <Button x:Name="DebuggerButton" Content="Start" Click="OnDebuggerToggle" />
          <TextBlock VerticalAlignment="Center" Foreground="#888" Text="{Binding Debugger.StatusMessage}" />
        </StackPanel>
        <ScrollViewer Grid.Row="2">
          <TextBox Text="{Binding Debugger.LogText}" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                   FontFamily="Consolas,Courier New,monospace" FontSize="11" />
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
