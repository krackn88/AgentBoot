<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:OpenBullet.Linux.Services"
             xmlns:vm="clr-namespace:RuriLib.ViewModels;assembly=RuriLib"
             x:Class="OpenBullet.Linux.Views.ConfigManagerView"
             x:DataType="services:ConfigManagerHost">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="*,*" Grid.Row="0" Margin="0,0,0,6">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Current Config:" FontWeight="Bold" Foreground="#DCDCDC" />
        <TextBlock Text="{Binding CurrentConfigName}" FontWeight="Bold" Foreground="#1E90FF" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <TextBlock Text="Total Configs:" FontWeight="Bold" Foreground="#DCDCDC" />
        <TextBlock Text="{Binding Total}" Foreground="#DCDCDC" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
      <Button Content="New" Click="OnNew" />
      <Button Content="Edit" Click="OnEdit" />
      <Button Content="Save" Click="OnSave" />
      <Button Content="Delete" Click="OnDelete" />
      <TextBox Width="140" Watermark="Filter" Text="{Binding SearchString}" />
      <Button Content="Rescan" Click="OnRescan" />
      <Button Content="Open in Runner" Click="OnOpenInRunner" />
    </StackPanel>

    <ListBox Grid.Row="2" x:Name="ConfigList" ItemsSource="{Binding FilteredConfigs}"
             SelectionChanged="OnSelectionChanged" Background="#1a1a1a" Foreground="#DCDCDC">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ConfigViewModel">
          <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
            <TextBlock Text="{Binding Category}" Foreground="#888" FontSize="11" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="#ADFF2F" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
