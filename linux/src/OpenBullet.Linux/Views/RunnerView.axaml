<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RuriLib.Models;assembly=RuriLib"
             x:Class="OpenBullet.Linux.Views.RunnerView"
             x:DataType="services:RunnerHost"
             xmlns:services="clr-namespace:OpenBullet.Linux.Services">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto" Grid.Row="0">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Config:" Foreground="{DynamicResource ObForegroundMain}" VerticalAlignment="Center" />
          <TextBox Classes="ob-input" Width="320" Text="{Binding ConfigPath}" Watermark="path/to/config.loli" />
          <Button Content="Load" Click="OnLoadClicked" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Wordlist:" Foreground="{DynamicResource ObForegroundMain}" VerticalAlignment="Center" />
          <TextBox Classes="ob-input" Width="320" Text="{Binding WordlistPath}" Watermark="path/to/wordlist.txt" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1" Classes="ob-primary" MinWidth="90" MinHeight="60" Content="{Binding StartButtonLabel}"
              Click="OnStartClicked" VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,300" Margin="0,8,0,0">
      <StackPanel Spacing="4">
        <TextBlock Foreground="{DynamicResource ObForegroundMain}">
          <Run Text="Progress: " />
          <Run Text="{Binding Runner.ProgressCount}" />
          <Run Text=" / " />
          <Run Text="{Binding Runner.WordlistSize}" />
          <Run Text=" (" />
          <Run Text="{Binding Runner.Progress}" />
          <Run Text="%)" />
        </TextBlock>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Runner.Progress}" Height="14" />
        <TextBlock Foreground="{DynamicResource ObForegroundGood}" Text="{Binding Runner.Master.Status}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Foreground="{DynamicResource ObForegroundMain}" Text="{Binding Runner.ConfigName, StringFormat=Config: {0}}" />
        <TextBlock Foreground="{DynamicResource ObForegroundMain}" Text="{Binding Runner.WordlistName, StringFormat=Wordlist: {0}}" />
        <TextBlock Foreground="{DynamicResource ObForegroundMain}" Text="{Binding Runner.BotsAmount, StringFormat=Bots: {0}}" />
        <TextBlock Foreground="{DynamicResource ObForegroundMain}">
          <Run Text="Hits: " />
          <Run Text="{Binding Runner.HitCount}" Foreground="{DynamicResource ObForegroundGood}" />
          <Run Text="  Custom: " />
          <Run Text="{Binding Runner.CustomCount}" />
          <Run Text="  CPM: " />
          <Run Text="{Binding Runner.CPM}" />
        </TextBlock>
        <TextBlock Foreground="#AAAAAA" Text="{Binding PluginSummary}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,8,340" Margin="0,8,0,0">
      <Border Background="{DynamicResource ObBackgroundSecondary}" Padding="8" CornerRadius="2">
        <ScrollViewer>
          <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                   Foreground="{DynamicResource ObForegroundMain}" FontFamily="Consolas,Courier New,monospace" />
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="2" RowDefinitions="*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource ObBackgroundSecondary}" Padding="4" CornerRadius="2">
          <ListBox ItemsSource="{Binding DisplayedHits}" SelectionMode="Multiple">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:ValidData">
                <Grid ColumnDefinitions="72,*,56,48" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontSize="11" Opacity="0.85" />
                  <TextBlock Grid.Column="1" Text="{Binding Data}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="11" />
                  <TextBlock Grid.Column="3" Text="{Binding Proxy}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
          <Button Content="Hits" Click="OnFilterHits" Classes.ob-active="{Binding FilterHitsActive}" />
          <Button Content="Custom" Click="OnFilterCustom" Classes.ob-active="{Binding FilterCustomActive}" />
          <Button Content="ToCheck" Click="OnFilterToCheck" Classes.ob-active="{Binding FilterToCheckActive}" />
        </StackPanel>
      </Grid>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="Stop Camoufox server" Click="OnStopCamoufoxServer" />
      <Button Content="Kill Camoufox" Click="OnKillCamoufox" />
      <Button Content="Reload plugins" Click="OnReloadPlugins" />
    </StackPanel>
  </Grid>
</UserControl>
