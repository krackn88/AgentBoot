<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenBullet.Linux.Views.CamoufoxToolsView">
  <StackPanel Spacing="8">
    <TextBlock Text="CARE: These might interfere with other browser automation you are running"
               Foreground="#FF6347" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Stop Camoufox server" Click="OnStopServer" />
      <Button Content="Kill Camoufox processes" Click="OnKillCamoufox" />
      <Button Content="Kill Playwright Firefox" Click="OnKillFirefox" />
      <Button Content="Delete Firefox temp profiles" Click="OnDeleteTemp" />
    </StackPanel>
    <TextBlock Foreground="#888888" TextWrapping="Wrap"
               Text="Linux builds use Camoufox (anti-detect Firefox) via Playwright. Install: pip install camoufox &amp;&amp; python3 -m camoufox fetch &amp;&amp; dotnet build &amp;&amp; playwright install firefox" />
  </StackPanel>
</UserControl>
