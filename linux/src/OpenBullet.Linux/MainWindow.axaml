<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenBullet.Linux.Views"
        x:Class="OpenBullet.Linux.MainWindow"
        Title="Open Bullet"
        Width="800" Height="620"
        MinWidth="800" MinHeight="600"
        Background="#222222"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        SystemDecorations="BorderOnly">
  <Grid RowDefinitions="30,30,*">
    <Grid Grid.Row="0" Background="#111111" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="4,0">
        <Border Width="22" Height="22" Background="#1E90FF" CornerRadius="2" />
        <TextBlock Text="Open Bullet" Foreground="#DCDCDC" FontSize="14" VerticalAlignment="Center" />
      </StackPanel>
      <Panel Grid.Column="1" Background="#111111" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0">
        <TextBlock Text="—" Foreground="#DCDCDC" VerticalAlignment="Center" />
        <TextBlock Text="□" Foreground="#DCDCDC" VerticalAlignment="Center" />
        <TextBlock Text="×" Foreground="#DCDCDC" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="10,0">
      <TextBlock Text="Runner" FontWeight="Bold" Foreground="#DCDCDC" />
      <TextBlock Text="Configs" FontWeight="Bold" Foreground="#DCDCDC" />
      <TextBlock Text="About" FontWeight="Bold" Foreground="#1E90FF" />
      <TextBlock Text="Settings" FontWeight="Bold" Foreground="#DCDCDC" />
    </StackPanel>

    <Border Grid.Row="2" Margin="10" Background="#111111" CornerRadius="2" Padding="16">
      <views:AboutView />
    </Border>
  </Grid>
</Window>
